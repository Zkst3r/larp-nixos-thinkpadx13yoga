{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/cat.png",
    "width": 22,
    "height": 13,
    "padding": {
      "top": 0,
      "left": 1,
      "right": 3
    },
    "preserveAspectRatio": false
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
      "title": "magenta"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    "break",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": "Pkgs",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "Term",
      "keyColor": "magenta"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "magenta",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "magenta",
      "temp": false,
      "format": "{name}"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
